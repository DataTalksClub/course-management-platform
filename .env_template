DB_PASSWORD='password'
DJANGO_SECRET='secret'
SITE_ID=3
IS_LOCAL=1
AUTH_TOKEN='token'
DEV_AUTH_TOKEN='token'
NGROK_AUTHTOKEN='your_ngrok_authtoken_here'

RELAY_URL='https://relay.datatalks.club'
RELAY_API_KEY='token'
RELAY_CLIENT='dtc-courses'
RELAY_AUDIENCE='dtc-courses'
RELAY_FROM_EMAIL='courses'
RELAY_STRICT=0
# Bulk list sends post every recipient inline; keep this well above the
# transactional-sized default.
RELAY_TIMEOUT_SECONDS=60
RELAY_SYNC_ON_USER_CREATE=1

# Observability
# Local default: OBSERVABILITY_EVENT_BACKENDS=log.
# Deployed AWS environments should use OBSERVABILITY_EVENT_BACKENDS=cloudwatch.
OBSERVABILITY_ENVIRONMENT=local
OBSERVABILITY_EVENT_BACKENDS=log
CLOUDWATCH_APP_METRIC_NAMESPACE='CourseManagement/App'
